# ── Python ──────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/

# ── 虚拟环境 ────────────────────────────────────────────
venv/
venv310/
.venv/
env/

# ── wheel 缓存（体积大；由 py/fetch_wheels.py 下载）──────────────────────
wheels/*
!wheels/.gitkeep
*.whl
*.part

# ── 模型权重与引擎（体积大；用 sh/download.sh 获取、sh/build_engine.sh 构建）──
models/*.pth
models/*.pt
models/*.onnx
models/*.engine
*.pth
*.engine
# ONNX 外部数据文件（vit_l / vit_h 权重 >2GB 时由 export_onnx.py 自动生成在 models/）
models/enc.*
models/onnx__*
models/.onnx.data

# ── 运行时产物 ──────────────────────────────────────────
# 服务运行时文件（socket / pid / 日志）
run/*
!run/.gitkeep

# 日志
logs/*.log
logs/*.txt
logs/*.json
logs/pp/
*.log

# 可视化与掩码输出（含子目录，如 outputimage/b|h|l/）
outputimage/**/*.png
outputimage/**/*.jpg
outputimage/**/*.jpeg
outputimage/*.png
outputimage/*.jpg
outputimage/*.jpeg
outputs/*
!outputs/.gitkeep

# ── 编辑器 / 系统 ───────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db